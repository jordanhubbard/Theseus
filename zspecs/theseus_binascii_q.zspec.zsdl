spec: theseus_binascii_q
version: ">=3.9"
backend: python_cleanroom(theseus_binascii_q)
blocks: binascii

docs: https://docs.python.org/3/library/binascii.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/binascii.html"
    - "ISO/IEC 3309 CRC-32"
  not_derived_from:
    - "CPython source: Modules/binascii.c"
  notes:
    - "Clean-room binascii. Do NOT import binascii."
    - "Export: crc32, hexlify, unhexlify, Error."
    - "Authority: gold/binascii/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

invariant theseus_binascii_q.crc32.empty:
  description: "crc32(b'') == 0"
  category: crc32
  kind: python_call_eq
  function: crc32
  args: [{type: bytes_ascii, value: ""}]
  expected: 0

invariant theseus_binascii_q.crc32.itu_v42_check:
  description: "crc32(b'123456789') == 3421780262"
  category: crc32
  rfc: "ISO/IEC 3309 CRC-32"
  kind: python_call_eq
  function: crc32
  args: [{type: bytes_ascii, value: "123456789"}]
  expected: 3421780262

invariant theseus_binascii_q.crc32.hello:
  description: "crc32(b'hello') == 907060870"
  category: crc32
  kind: python_call_eq
  function: crc32
  args: [{type: bytes_ascii, value: "hello"}]
  expected: 907060870

invariant theseus_binascii_q.hexlify.hello_length:
  description: "hexlify(b'hello').__len__() == 10"
  category: hexlify
  kind: python_call_eq
  function: hexlify
  args: [{type: bytes_ascii, value: "hello"}]
  method: __len__
  expected: 10

invariant theseus_binascii_q.unhexlify.hello_value:
  description: "unhexlify('68656c6c6f') == b'hello'"
  category: unhexlify
  kind: python_call_eq
  function: unhexlify
  args: ["68656c6c6f"]
  expected: {type: bytes_ascii, value: "hello"}

invariant theseus_binascii_q.unhexlify.odd_length_raises:
  description: "unhexlify('fff') raises Error"
  category: error
  kind: python_call_raises
  function: unhexlify
  args: ["fff"]
  expected_exception: Error
