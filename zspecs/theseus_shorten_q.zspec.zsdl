spec: theseus_shorten_q
version: ">=3.9"
backend: python_cleanroom(theseus_shorten_q)
blocks: textwrap

docs: https://docs.python.org/3/library/textwrap.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/textwrap.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room textwrap.shorten. Do NOT import textwrap."
    - "Export: shorten."
    - "shorten collapses whitespace and truncates to width using the default placeholder."
    - "Authority: gold/shorten/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_shorten_q.too_narrow:
  description: "width too small for the words"
  kind: python_call_eq
  function: shorten
  args: ["hello world"]
  kwargs: {width: 10}
  expected: "[...]"
