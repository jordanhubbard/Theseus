spec: theseus_pprint_q
version: ">=3.9"
backend: python_cleanroom(theseus_pprint_q)
blocks: pprint

docs: https://docs.python.org/3/library/pprint.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/pprint.html"
  not_derived_from:
    - "CPython source: Lib/pprint.py"
  notes:
    - "Clean-room pprint. Do NOT import pprint."
    - "Export: pformat."
    - "pformat returns a string. Lists use comma-space separators. Strings are quoted."
    - "Authority: gold/pprint/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_pprint_q.list_123:
  description: "format a short list"
  kind: python_call_eq
  function: pformat
  args: [[1, 2, 3]]
  expected: "[1, 2, 3]"

invariant theseus_pprint_q.str_hi:
  description: "format a short string"
  kind: python_call_eq
  function: pformat
  args: ["hi"]
  expected: "'hi'"
