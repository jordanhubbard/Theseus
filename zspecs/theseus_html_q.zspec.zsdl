spec: theseus_html_q
version: ">=3.9"
backend: python_cleanroom(theseus_html_q)
blocks: html

docs: https://docs.python.org/3/library/html.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/html.html"
  not_derived_from:
    - "CPython source: Lib/html/__init__.py"
  notes:
    - "Clean-room html. Do NOT import html."
    - "Export: escape, unescape."
    - "escape converts & < > and, by default, quotes. unescape applies HTML5 named and numeric references."
    - "Authority: gold/html/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_html_q.escape_tag:
  description: "escape a tag"
  kind: python_call_eq
  function: escape
  args: ["<b>"]
  expected: "&lt;b&gt;"

invariant theseus_html_q.unescape_amp:
  description: "unescape amp"
  kind: python_call_eq
  function: unescape
  args: ["&amp;"]
  expected: "&"
