spec: theseus_bisect_q
version: ">=3.9"
backend: python_cleanroom(theseus_bisect_q)
blocks: bisect

docs: https://docs.python.org/3/library/bisect.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/bisect.html"
  not_derived_from:
    - "CPython source: Lib/bisect.py"
  notes:
    - "Clean-room bisect. Do NOT import bisect."
    - "Export: bisect_left, bisect_right, bisect, insort_left, insort_right, insort."
    - "Authority: gold/bisect/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

table theseus_bisect_q.left:
  kind: python_call_eq
  function: bisect_left
  id_prefix: left

  columns: [id, args, expected]
  rows:
    - [present, [[1, 3, 5, 7, 9], 5], 2]
    - [before,  [[1, 3, 5, 7, 9], 0], 0]
    - [after,   [[1, 3, 5, 7, 9], 10], 5]

table theseus_bisect_q.right:
  kind: python_call_eq
  function: bisect_right
  id_prefix: right

  columns: [id, args, expected]
  rows:
    - [present, [[1, 3, 5, 7, 9], 5], 3]

invariant theseus_bisect_q.alias:
  description: "bisect is bisect_right"
  kind: python_call_eq
  function: bisect
  args: [[1, 2, 2, 3], 2]
  expected: 3
