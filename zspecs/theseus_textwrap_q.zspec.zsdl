spec: theseus_textwrap_q
version: ">=3.9"
backend: python_cleanroom(theseus_textwrap_q)
blocks: textwrap

docs: https://docs.python.org/3/library/textwrap.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/textwrap.html"
  not_derived_from:
    - "CPython source: Lib/textwrap.py"
  notes:
    - "Clean-room textwrap. Do NOT import textwrap."
    - "Export: wrap, fill, dedent, indent, shorten."
    - "Authority: gold/textwrap/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_textwrap_q.fill_hello:
  description: "fill hello world at width 8"
  kind: python_call_eq
  function: fill
  args: ["hello world"]
  kwargs: {width: 8}
  expected: "hello\nworld"

invariant theseus_textwrap_q.dedent_xy:
  description: "dedent two spaces"
  kind: python_call_eq
  function: dedent
  args: ["  x\n  y\n"]
  expected: "x\ny\n"
