blocks: operator

docs: https://docs.python.org/3/library/operator.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/operator.html"
  not_derived_from:
    - "CPython source: Lib/operator.py"
  notes:
    - "Clean-room operator. Do NOT import operator."
    - "Export: add, sub, mul, getitem, itemgetter."
    - "Authority: gold/operator/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_operator_q.add_basic:
  description: "add two and three"
  kind: python_call_eq
  function: add
  args: [2, 3]
  expected: 5

invariant theseus_operator_q.getitem_basic:
  description: "first item"
  kind: python_call_eq
  function: getitem
  args: [["x", "y"], 0]
  expected: "x"
