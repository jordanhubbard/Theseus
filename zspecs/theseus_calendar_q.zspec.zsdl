spec: theseus_calendar_q
version: ">=3.9"
backend: python_cleanroom(theseus_calendar_q)
blocks: calendar

docs: https://docs.python.org/3/library/calendar.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/calendar.html"
  not_derived_from:
    - "CPython source: Lib/calendar.py"
  notes:
    - "Clean-room calendar. Do NOT import calendar."
    - "Export: isleap, weekday, leapdays, monthrange."
    - "isleap is the proleptic Gregorian rule: divisible by 4, except centuries not divisible by 400."
    - "weekday is 0=Monday through 6=Sunday. monthrange returns (weekday of the 1st, number of days)."
    - "Authority: gold/calendar/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_calendar_q.leap_2024:
  description: "2024 is a leap year"
  kind: python_call_eq
  function: isleap
  args: [2024]
  expected: true

invariant theseus_calendar_q.monday_2024:
  description: "1 January 2024 is Monday"
  kind: python_call_eq
  function: weekday
  args: [2024, 1, 1]
  expected: 0

invariant theseus_calendar_q.february_2024:
  description: "February 2024 starts Thursday and has 29 days"
  kind: python_call_eq
  function: monthrange
  args: [2024, 2]
  expected: !tuple [3, 29]
