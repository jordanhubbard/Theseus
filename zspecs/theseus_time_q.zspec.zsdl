spec: theseus_time_q
version: ">=3.9"
backend: python_cleanroom(theseus_time_q)
blocks: time

docs: https://docs.python.org/3/library/time.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/time.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room time.gmtime. Do NOT import time."
    - "Export: gmtime."
    - "gmtime(0) is 1970-01-01 UTC. tm_year is the year. tm_mon is the 1-based month."
    - "Authority: gold/time/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_time_q.epoch_year:
  description: "epoch year is 1970"
  kind: python_call_eq
  function: gmtime
  args: [0]
  method: tm_year
  method_args: []
  expected: 1970
