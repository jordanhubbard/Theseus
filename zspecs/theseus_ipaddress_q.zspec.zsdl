spec: theseus_ipaddress_q
version: ">=3.9"
backend: python_cleanroom(theseus_ipaddress_q)
blocks: ipaddress

docs: https://docs.python.org/3/library/ipaddress.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/ipaddress.html"
    - "RFC 791"
    - "RFC 1918"
  not_derived_from:
    - "CPython source: Lib/ipaddress.py"
  notes:
    - "Clean-room ipaddress. Do NOT import ipaddress."
    - "Export: IPv4Address."
    - "IPv4Address parses a dotted quad. str returns that text. is_loopback is true for 127.0.0.0/8. is_private is true for RFC 1918 10/8, 172.16/12, and 192.168/16."
    - "Authority: gold/ipaddress/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

