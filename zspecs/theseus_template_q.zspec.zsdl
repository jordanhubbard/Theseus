spec: theseus_template_q
version: ">=3.9"
backend: python_cleanroom(theseus_template_q)
blocks: string

docs: https://docs.python.org/3/library/string.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/string.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room string.Template. Do NOT import string."
    - "Export: Template."
    - "Template.substitute replaces $identifiers from keyword arguments."
    - "Authority: gold/template/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_template_q.one_name:
  description: "one identifier is replaced"
  kind: python_call_eq
  function: Template
  args: ["$name"]
  method: substitute
  method_args: [{"name": "Pat"}]
  expected: "Pat"
