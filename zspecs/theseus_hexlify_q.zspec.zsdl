spec: theseus_hexlify_q
version: ">=3.9"
backend: python_cleanroom(theseus_hexlify_q)
blocks: binascii

docs: https://docs.python.org/3/library/binascii.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/binascii.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room binascii.hexlify. Do NOT import binascii."
    - "Export: hexlify."
    - "hexlify returns lowercase hex digits as bytes."
    - "Authority: gold/hexlify/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_hexlify_q.two_bytes:
  description: "two bytes become four hex digits"
  kind: python_call_eq
  function: hexlify
  args: [!ascii "ab"]
  expected: !ascii "6162"
