spec: theseus_hmac_q
version: ">=3.8"
backend: python_cleanroom(theseus_hmac_q)
blocks: hmac

docs: https://docs.python.org/3/library/hmac.html
rfcs:
  - "RFC 2104"
  - "RFC 4231"

provenance:
  derived_from:
    - "RFC 2104"
    - "RFC 4231 Test Case 1 and 2"
    - "https://docs.python.org/3/library/hmac.html"
  not_derived_from:
    - "CPython source: Lib/hmac.py"
  notes:
    - "Clean-room HMAC. Do NOT import hmac. hashlib is allowed."
    - "Export: new, digest, compare_digest, HMAC."
    - "Authority: gold/hmac/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

table theseus_hmac_q.compare_digest.strings:
  kind: python_call_eq
  category: compare_digest
  id_prefix: compare_digest
  function: compare_digest

  columns: [id, args, expected]
  rows:
    - [equal_abc,       ["abc",   "abc"],   true]
    - [unequal_abc_abd, ["abc",   "abd"],   false]
    - [empty_equal,     ["",      ""],      true]
    - [hello_world,     ["hello", "world"], false]

invariant theseus_hmac_q.new.sha256.hexdigest:
  description: "hmac.new(b'key', b'msg', 'sha256').hexdigest()"
  category: known_vector
  kind: python_call_eq
  function: new
  args:
    - {type: bytes_ascii, value: "key"}
    - {type: bytes_ascii, value: "msg"}
    - "sha256"
  method: hexdigest
  expected: "2d93cbc1be167bcb1637a4a23cbff01a7878f0c50ee833954ea5221bb1b8c628"

invariant theseus_hmac_q.new.sha256.digest_size:
  description: "digest_size == 32"
  category: properties
  kind: python_call_eq
  function: new
  args:
    - {type: bytes_ascii, value: "key"}
    - {type: bytes_ascii, value: "msg"}
    - "sha256"
  method: digest_size
  expected: 32

invariant theseus_hmac_q.new.sha256.name:
  description: "name == hmac-sha256"
  category: properties
  kind: python_call_eq
  function: new
  args:
    - {type: bytes_ascii, value: "key"}
    - {type: bytes_ascii, value: "msg"}
    - "sha256"
  method: name
  expected: "hmac-sha256"

invariant theseus_hmac_q.rfc4231.tc1_sha256:
  description: "RFC 4231 Test Case 1 HMAC-SHA-256"
  category: known_vector
  rfc: "RFC 4231 §4.2 Test Case 1"
  kind: python_call_eq
  function: new
  args:
    - {type: bytes_hex, value: "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"}
    - {type: bytes_ascii, value: "Hi There"}
    - "sha256"
  method: hexdigest
  expected: "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"
