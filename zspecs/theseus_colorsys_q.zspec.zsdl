spec: theseus_colorsys_q
version: ">=3.9"
backend: python_cleanroom(theseus_colorsys_q)
blocks: colorsys

docs: https://docs.python.org/3/library/colorsys.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/colorsys.html"
  not_derived_from:
    - "CPython source: Lib/colorsys.py"
  notes:
    - "Clean-room colorsys. Do NOT import colorsys."
    - "Export: rgb_to_hsv, hsv_to_rgb, rgb_to_hls, hls_to_rgb, rgb_to_yiq, yiq_to_rgb."
    - "Components are floats in 0..1 except YIQ I and Q."
    - "Authority: gold/colorsys/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_colorsys_q.red_hsv:
  description: "pure red in HSV"
  kind: python_call_eq
  function: rgb_to_hsv
  args: [1.0, 0.0, 0.0]
  expected: !tuple [0.0, 1.0, 1.0]

invariant theseus_colorsys_q.red_back:
  description: "HSV red back to RGB"
  kind: python_call_eq
  function: hsv_to_rgb
  args: [0.0, 1.0, 1.0]
  expected: !tuple [1.0, 0.0, 0.0]
