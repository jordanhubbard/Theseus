spec: theseus_fnmatch_q
version: ">=3.9"
backend: python_cleanroom(theseus_fnmatch_q)
blocks: fnmatch

docs: https://docs.python.org/3/library/fnmatch.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/fnmatch.html"
  not_derived_from:
    - "CPython source: Lib/fnmatch.py"
  notes:
    - "Clean-room fnmatch. Do NOT import fnmatch."
    - "Export: fnmatch, fnmatchcase, filter."
    - "Authority: gold/fnmatch/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

table theseus_fnmatch_q.star:
  kind: python_call_eq
  function: fnmatch
  id_prefix: star

  columns: [id, args, expected]
  rows:
    - [py_match,      ["hello.py",  "*.py"],   true]
    - [js_no_match,   ["hello.js",  "*.py"],   false]
    - [md_match,      ["README.md", "*.md"],   true]
    - [star_all,      ["hello",     "*"],      true]
    - [star_empty,    ["",          "*"],      true]
    - [file_dot_star, ["file.py",   "file.*"], true]
    - [file_nodot,    ["file",      "file.*"], false]

table theseus_fnmatch_q.fnmatchcase:
  kind: python_call_eq
  function: fnmatchcase
  id_prefix: fnmatchcase

  columns: [id, args, expected]
  rows:
    - [lower_match, ["hello.py", "*.py"],  true]
    - [upper_no,    ["HELLO.PY", "*.py"],  false]
    - [upper_yes,   ["HELLO.PY", "*.PY"],  true]
