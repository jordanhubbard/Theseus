spec: theseus_unhexlify_q
version: ">=3.9"
backend: python_cleanroom(theseus_unhexlify_q)
blocks: binascii

docs: https://docs.python.org/3/library/binascii.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/binascii.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room binascii.unhexlify. Do NOT import binascii."
    - "Export: unhexlify."
    - "unhexlify turns each pair of hex digits into one byte."
    - "Authority: gold/unhexlify/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_unhexlify_q.two_digits:
  description: "four hex digits become two bytes"
  kind: python_call_eq
  function: unhexlify
  args: [!ascii "6162"]
  expected: !ascii "ab"
