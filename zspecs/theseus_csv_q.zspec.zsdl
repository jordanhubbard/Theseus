spec: theseus_csv_q
version: ">=3.9"
backend: python_cleanroom(theseus_csv_q)
blocks: csv

docs: https://docs.python.org/3/library/csv.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/csv.html"
    - "RFC 4180"
  not_derived_from:
    - "CPython source: Lib/csv.py"
  notes:
    - "Clean-room csv. Do NOT import csv."
    - "Export: reader."
    - "reader yields each row as a list of strings. The default delimiter is a comma."
    - "Authority: gold/csv/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_csv_q.comma_row:
  description: "one comma-separated row"
  kind: python_call_eq
  function: reader
  args: [["a,b"]]
  method: __next__
  method_args: []
  expected: ["a", "b"]
