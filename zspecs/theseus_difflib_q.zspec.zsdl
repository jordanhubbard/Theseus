spec: theseus_difflib_q
version: ">=3.2"
backend: python_cleanroom(theseus_difflib_q)
blocks: difflib

docs: https://docs.python.org/3/library/difflib.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/difflib.html"
  not_derived_from:
    - "CPython source: Lib/difflib.py"
  notes:
    - "Clean-room difflib. Do NOT import difflib."
    - "Export: SequenceMatcher, get_close_matches, IS_CHARACTER_JUNK, IS_LINE_JUNK."
    - "Authority: gold/difflib/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

table theseus_difflib_q.sequence_matcher.ratio:
  kind: python_call_eq
  category: ratio
  id_prefix: sequence_matcher
  function: SequenceMatcher

  columns: [id, args, method, expected]
  rows:
    - [ratio_identical,           [null, "abcde", "abcde"], ratio,            1.0]
    - [ratio_disjoint,            [null, "abc",   "xyz"  ], ratio,            0.0]
    - [ratio_empty,               [null, "",      ""     ], ratio,            1.0]
    - [quick_ratio_identical,     [null, "hello", "hello"], quick_ratio,      1.0]
    - [real_quick_ratio_identical,[null, "hello","hello"], real_quick_ratio, 1.0]

table theseus_difflib_q.get_close_matches:
  kind: python_call_eq
  category: close_matches
  id_prefix: get_close_matches
  function: get_close_matches

  columns: [id, args, expected]
  rows:
    - [match_found, ["appel", ["apple", "peach", "puppy"]], ["apple"]]
    - [no_match,    ["xyz",   ["apple", "peach"]],          []]
    - [exact_match, ["apple", ["apple", "peach", "puppy"]], ["apple"]]

table theseus_difflib_q.is_character_junk:
  kind: python_call_eq
  category: junk
  id_prefix: is_character_junk
  function: IS_CHARACTER_JUNK

  columns: [id, args, expected]
  rows:
    - [space,  [" "],  true]
    - [tab,    ["\t"], true]
    - [letter, ["a"],  false]
