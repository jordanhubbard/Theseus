spec: theseus_getopt_q
version: ">=3.9"
backend: python_cleanroom(theseus_getopt_q)
blocks: getopt

docs: https://docs.python.org/3/library/getopt.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/getopt.html"
  not_derived_from:
    - "CPython source: Lib/getopt.py"
  notes:
    - "Clean-room getopt. Do NOT import getopt."
    - "Export: getopt."
    - "getopt(args, shortopts) returns (options, leftover). A short flag without a colon takes no value. Parsing stops at the first non-option."
    - "Authority: gold/getopt/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_getopt_q.two_flags:
  description: "two flags then a leftover"
  kind: python_call_eq
  function: getopt
  args: [["-a", "-b", "x"], "ab"]
  expected: !tuple
    - - !tuple ["-a", ""]
      - !tuple ["-b", ""]
    - ["x"]
