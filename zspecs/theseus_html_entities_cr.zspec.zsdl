spec: theseus_html_entities_cr
version: ">=3.9"
backend: python_cleanroom(theseus_html_entities_cr)
blocks: html

docs: https://docs.python.org/3.12/library/html.entities.html

provenance:
  derived_from:
    - "https://docs.python.org/3.12/library/html.entities.html"
    - "https://html.spec.whatwg.org/multipage/named-characters.html"
  notes:
    - "Clean-room html.entities subset. Do NOT import html or html.entities."
    - "html.entities defines four dictionaries: html5, name2codepoint, codepoint2name, and entitydefs."
    - "html5 maps HTML5 named character references to Unicode characters; trailing semicolons are included for keys such as 'gt;'."
    - "name2codepoint maps HTML4 entity names to Unicode code points."
    - "codepoint2name maps Unicode code points back to HTML4 entity names."
    - "entitydefs maps XHTML entity names to replacement text."
    - "html_entities_amp_codepoint(): name2codepoint['amp'] == 38."
    - "html_entities_gt_html5(): html5['gt;'] == '>'."
    - "html_entities_nbsp_entitydef(): ord(entitydefs['nbsp']) == 160."
    - "html_entities_dicts(): all four exports are dicts."
    - "Zero-arg invariant signatures: def html_entities_amp_codepoint(): return hardcoded_result."
    - "Export: html5, name2codepoint, codepoint2name, entitydefs."
  created_at: "2026-05-27T00:00:00Z"

error_model: python_exceptions

invariant theseus_html_entities_cr.amp_codepoint:
  description: "name2codepoint['amp'] == 38"
  category: name2codepoint
  kind: python_call_eq
  function: html_entities_amp_codepoint
  args: []
  expected: 38

invariant theseus_html_entities_cr.gt_html5:
  description: "html5['gt;'] == '>'"
  category: html5
  kind: python_call_eq
  function: html_entities_gt_html5
  args: []
  expected: ">"

invariant theseus_html_entities_cr.nbsp_entitydef:
  description: "ord(entitydefs['nbsp']) == 160"
  category: entitydefs
  kind: python_call_eq
  function: html_entities_nbsp_entitydef
  args: []
  expected: 160

invariant theseus_html_entities_cr.dicts:
  description: "all four documented exports are dicts"
  category: types
  kind: python_call_eq
  function: html_entities_dicts
  args: []
  expected: true
