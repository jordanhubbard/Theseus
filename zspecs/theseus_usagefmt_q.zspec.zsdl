spec: theseus_usagefmt_q
version: ">=3.9"
backend: python_cleanroom(theseus_usagefmt_q)
blocks: argparse

docs: https://docs.python.org/3/library/argparse.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/argparse.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room argparse.ArgumentParser.format_usage. Do NOT import argparse."
    - "Export: ArgumentParser."
    - "format_usage with no arguments is usage, the program name, and [-h]."

    - "Authority: gold/usagefmt/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_usagefmt_q.prog:
  description: "default usage names the program"
  kind: python_call_eq
  function: ArgumentParser
  kwargs: {prog: "prog"}
  method: format_usage
  method_args: []
  expected: "usage: prog [-h]\n"
