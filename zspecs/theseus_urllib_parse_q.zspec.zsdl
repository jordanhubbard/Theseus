spec: theseus_urllib_parse_q
version: ">=3.4"
backend: python_cleanroom(theseus_urllib_parse_q)
blocks: urllib.parse

docs: https://docs.python.org/3/library/urllib.parse.html
rfcs:
  - "RFC 3986"

provenance:
  derived_from:
    - "https://docs.python.org/3/library/urllib.parse.html"
    - "RFC 3986"
  not_derived_from:
    - "CPython source: Lib/urllib/parse.py"
  notes:
    - "Clean-room urllib.parse. Do NOT import urllib.parse."
    - "Export: urlparse, urljoin, quote, unquote, urlencode, parse_qs, urlunparse."
    - "Authority: gold/urllib_parse/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

table theseus_urllib_parse_q.urlparse.components:
  kind: python_call_eq
  category: urlparse
  id_prefix: urlparse
  function: urlparse
  args: ["https://example.com:8080/path?q=1&r=2#frag"]

  columns: [id, method, expected]
  rows:
    - [scheme,   scheme,   "https"]
    - [netloc,   netloc,   "example.com:8080"]
    - [path,     path,     "/path"]
    - [query,    query,    "q=1&r=2"]
    - [fragment, fragment, "frag"]
    - [port,     port,     8080]

invariant theseus_urllib_parse_q.urlparse.rfc3986_example:
  description: "RFC 3986 example host"
  category: urlparse
  rfc: "RFC 3986"
  kind: python_call_eq
  function: urlparse
  args: ["http://www.ics.uci.edu/pub/ietf/uri/#Related"]
  method: netloc
  expected: "www.ics.uci.edu"

invariant theseus_urllib_parse_q.urlunparse.roundtrip_shape:
  description: "urlunparse six-tuple rebuild"
  category: joining
  kind: python_call_eq
  function: urlunparse
  args: [["https", "ex.com", "/a", "", "q=1", "f"]]
  expected: "https://ex.com/a?q=1#f"

invariant theseus_urllib_parse_q.urlparse.userinfo:
  description: "username from userinfo"
  category: urlparse
  kind: python_call_eq
  function: urlparse
  args: ["https://user:pass@host.example.com/resource"]
  method: username
  expected: "user"

table theseus_urllib_parse_q.quoting:
  kind: python_call_eq
  category: quoting

  columns: [id, function, args, kwargs, expected]
  rows:
    - [quote.spaces,            quote,       ["/path with spaces"], {safe: "/"}, "/path%20with%20spaces"]
    - [quote.empty_safe,        quote,       ["/path"],             {safe: ""},  "%2Fpath"]
    - [quote_plus.spaces,       quote_plus,  ["hello world"],       ~,           "hello+world"]
    - [unquote.percent_encoded, unquote,     ["%2Fpath%20with%20spaces"], ~,    "/path with spaces"]

table theseus_urllib_parse_q.joining:
  kind: python_call_eq
  category: joining
  id_prefix: urljoin
  function: urljoin

  columns: [id, args, expected]
  rows:
    - [relative,           ["https://example.com/base/", "../other"],               "https://example.com/other"]
    - [absolute_overrides, ["https://example.com/base/", "https://other.com/page"], "https://other.com/page"]

invariant theseus_urllib_parse_q.urlencode.simple:
  description: "urlencode insertion-order dict"
  category: encoding
  kind: python_call_eq
  function: urlencode
  args: [{a: "1", b: "2"}]
  expected: "a=1&b=2"

table theseus_urllib_parse_q.parse_qs:
  kind: python_call_eq
  category: parsing
  id_prefix: parse_qs
  function: parse_qs

  columns: [id, args, expected]
  rows:
    - [multi_value,  ["a=1&b=2&a=3"], {a: ["1", "3"], b: ["2"]}]
    - [single_value, ["key=value"],   {key: ["value"]}]
