spec: theseus_reprlib_q
version: ">=3.9"
backend: python_cleanroom(theseus_reprlib_q)
blocks: reprlib

docs: https://docs.python.org/3/library/reprlib.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/reprlib.html"
  not_derived_from:
    - "CPython source: Lib/reprlib.py"
  notes:
    - "Clean-room reprlib. Do NOT import reprlib."
    - "Export: repr."
    - "repr of a short list matches the usual Python list text."
    - "Authority: gold/reprlib/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_reprlib_q.short_list:
  description: "short list is not truncated"
  kind: python_call_eq
  function: repr
  args: [[1, 2, 3]]
  expected: "[1, 2, 3]"
