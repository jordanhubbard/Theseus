spec: theseus_statistics_q
version: ">=3.9"
backend: python_cleanroom(theseus_statistics_q)
blocks: statistics

docs: https://docs.python.org/3/library/statistics.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/statistics.html"
  not_derived_from:
    - "CPython source: Lib/statistics.py"
  notes:
    - "Clean-room statistics. Do NOT import statistics."
    - "Export: fmean, median."
    - "fmean always returns a float. median of an odd-length list is the middle value."
    - "Authority: gold/statistics/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_statistics_q.fmean_123:
  description: "fast mean of 1, 2, 3"
  kind: python_call_eq
  function: fmean
  args: [[1, 2, 3]]
  expected: 2.0

invariant theseus_statistics_q.median_odd:
  description: "median of three ints"
  kind: python_call_eq
  function: median
  args: [[1, 2, 3]]
  expected: 2
