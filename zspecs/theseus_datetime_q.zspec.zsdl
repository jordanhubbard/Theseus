spec: theseus_datetime_q
version: ">=3.9"
backend: python_cleanroom(theseus_datetime_q)
blocks: datetime

docs: https://docs.python.org/3/library/datetime.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/datetime.html"
  not_derived_from:
    - "CPython source: Lib/datetime.py"
  notes:
    - "Clean-room datetime. Do NOT import datetime."
    - "Export: date."
    - "date(year, month, day).isoformat() is YYYY-MM-DD. February has 29 days in a leap year."
    - "Authority: gold/datetime/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_datetime_q.leap_day:
  description: "isoformat of a leap day"
  kind: python_call_eq
  function: date
  args: [2024, 2, 29]
  method: isoformat
  method_args: []
  expected: "2024-02-29"
