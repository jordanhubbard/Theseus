spec: theseus_quopri_q
version: ">=3.9"
backend: python_cleanroom(theseus_quopri_q)
blocks: quopri

docs: https://docs.python.org/3/library/quopri.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/quopri.html"
    - "RFC 2045"
  not_derived_from:
    - "CPython source: Lib/quopri.py"
  notes:
    - "Clean-room quopri. Do NOT import quopri."
    - "Export: encodestring, decodestring, encode, decode."
    - "encodestring and decodestring take and return bytes."
    - "Authority: gold/quopri/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_quopri_q.plain:
  description: "plain ascii encodes unchanged"
  kind: python_call_eq
  function: encodestring
  args: [!ascii "plain"]
  expected: !ascii "plain"

invariant theseus_quopri_q.newline:
  description: "quoted newline decodes"
  kind: python_call_eq
  function: decodestring
  args: [!ascii "A=0A"]
  expected: !ascii "A\n"
