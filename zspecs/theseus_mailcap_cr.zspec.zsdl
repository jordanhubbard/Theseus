spec: theseus_mailcap_cr
version: ">=3.9"
backend: python_cleanroom(theseus_mailcap_cr)
blocks: mailcap

docs: https://docs.python.org/3.12/library/mailcap.html

provenance:
  derived_from:
    - "https://docs.python.org/3.12/library/mailcap.html"
    - "RFC 1524 - A User Agent Configuration Mechanism For Multimedia Mail Format Information"
  notes:
    - "Clean-room mailcap subset. Do NOT import mailcap."
    - "mailcap.getcaps() returns a dictionary mapping MIME types to lists of mailcap entries."
    - "mailcap.findmatch(caps, MIMEtype, key='view', filename='/dev/null', plist=[]) returns (command, entry), or (None, None) when no match exists."
    - "The docs example maps video/mpeg with view 'xmpeg %s' and filename 'tmp1223' to command 'xmpeg tmp1223'."
    - "Parameter substitutions like %{id}, %{number}, and %{total} are replaced from plist entries of the form name=value."
    - "mailcap_getcaps_type(): isinstance(getcaps(), dict) is true."
    - "mailcap_findmatch_doc_example(): documented video/mpeg example returns 'xmpeg tmp1223'."
    - "mailcap_findmatch_none(): findmatch({}, 'text/plain') == (None, None)."
    - "mailcap_findmatch_params(): command 'showpartial %{id} %{number} %{total}' with plist ['id=1','number=2','total=3'] returns 'showpartial 1 2 3'."
    - "Zero-arg invariant signatures: def mailcap_getcaps_type(): return hardcoded_result."
    - "Export: getcaps(), findmatch(caps, MIMEtype, key='view', filename='/dev/null', plist=[]), lookup(caps, MIMEtype, key=None)."
  created_at: "2026-05-27T00:00:00Z"

error_model: python_exceptions

invariant theseus_mailcap_cr.getcaps_type:
  description: "getcaps() returns a dict"
  category: getcaps
  kind: python_call_eq
  function: mailcap_getcaps_type
  args: []
  expected: true

invariant theseus_mailcap_cr.findmatch_doc_example:
  description: "findmatch video/mpeg docs example returns 'xmpeg tmp1223'"
  category: findmatch
  kind: python_call_eq
  function: mailcap_findmatch_doc_example
  args: []
  expected: "xmpeg tmp1223"

invariant theseus_mailcap_cr.findmatch_none:
  description: "findmatch({}, 'text/plain') == (None, None)"
  category: findmatch
  kind: python_call_eq
  function: mailcap_findmatch_none
  args: []
  expected: true

invariant theseus_mailcap_cr.findmatch_params:
  description: "findmatch substitutes %{id}, %{number}, and %{total} from plist"
  category: findmatch
  kind: python_call_eq
  function: mailcap_findmatch_params
  args: []
  expected: "showpartial 1 2 3"
