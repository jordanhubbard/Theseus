spec: theseus_collections_q
version: ">=3.9"
backend: python_cleanroom(theseus_collections_q)
blocks: collections

docs: https://docs.python.org/3/library/collections.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/collections.html"
  not_derived_from:
    - "CPython source: Lib/collections/__init__.py"
  notes:
    - "Clean-room collections. Do NOT import collections."
    - "Export: Counter."
    - "Counter counts hashable items. most_common(n) returns the n highest counts. most_common() with no argument returns every item. Ties keep first-seen order."
    - "Authority: gold/collections/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_collections_q.top_one:
  description: "most common of a short string"
  kind: python_call_eq
  function: Counter
  args: ["aab"]
  method: most_common
  method_args: [1]
  expected:
    - !tuple ["a", 2]
