spec: theseus_keyword_q
version: ">=3.9"
backend: python_cleanroom(theseus_keyword_q)
blocks: keyword

docs: https://docs.python.org/3/library/keyword.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/keyword.html"
  not_derived_from:
    - "CPython source: Lib/keyword.py"
  notes:
    - "Clean-room keyword. Do NOT import keyword."
    - "Export: iskeyword, issoftkeyword, kwlist, softkwlist."
    - "Hard keywords include for. print is not a keyword. match is a soft keyword on 3.10+."
    - "Authority: gold/keyword/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_keyword_q.for_kw:
  description: "for is a keyword"
  kind: python_call_eq
  function: iskeyword
  args: ["for"]
  expected: true

invariant theseus_keyword_q.print_not:
  description: "print is not a keyword"
  kind: python_call_eq
  function: iskeyword
  args: ["print"]
  expected: false

invariant theseus_keyword_q.match_soft:
  description: "match is a soft keyword"
  kind: python_call_eq
  function: issoftkeyword
  args: ["match"]
  expected: true
