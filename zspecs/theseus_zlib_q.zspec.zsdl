spec: theseus_zlib_q
version: ">=3.9"
backend: python_cleanroom(theseus_zlib_q)
blocks: zlib

docs: https://docs.python.org/3/library/zlib.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/zlib.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room zlib.crc32. Do NOT import zlib."
    - "Export: crc32."
    - "crc32(data) is the unsigned ISO-HDLC CRC-32 of the bytes, starting from 0."
    - "Authority: gold/zlib/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_zlib_q.crc_hello:
  description: "crc of hello"
  kind: python_call_eq
  function: crc32
  args: [!ascii "hello"]
  expected: 907060870
