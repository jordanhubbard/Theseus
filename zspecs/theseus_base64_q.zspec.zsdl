spec: theseus_base64_q
version: ">=3.9"
backend: python_cleanroom(theseus_base64_q)
blocks: base64

docs: https://docs.python.org/3/library/base64.html
rfcs:
  - "RFC 4648 — The Base16, Base32, and Base64 Data Encodings"

provenance:
  derived_from:
    - "RFC 4648 §10 test vectors"
    - "https://docs.python.org/3/library/base64.html"
  not_derived_from:
    - "CPython source: Lib/base64.py"
  notes:
    - "Clean-room base64. Do NOT import base64 or binascii."
    - "Export: b64encode, b64decode, urlsafe_b64encode, urlsafe_b64decode, b32encode, b16encode."
    - "Authority: gold/base64/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

table theseus_base64_q.b64encode.rfc4648:
  kind: python_call_eq
  category: encode_vector
  rfc: "RFC 4648 §10"
  id_prefix: b64encode
  function: b64encode

  columns: [id, args, expected]
  rows:
    - [rfc4648_empty,  [!b64 ""],         !ascii ""]
    - [rfc4648_f,      [!b64 Zg==],       !ascii Zg==]
    - [rfc4648_fo,     [!b64 Zm8=],       !ascii Zm8=]
    - [rfc4648_foo,    [!b64 Zm9v],       !ascii Zm9v]
    - [rfc4648_foob,   [!b64 Zm9vYg==],   !ascii Zm9vYg==]
    - [rfc4648_fooba,  [!b64 Zm9vYmE=],   !ascii Zm9vYmE=]
    - [rfc4648_foobar, [!b64 Zm9vYmFy],   !ascii Zm9vYmFy]

table theseus_base64_q.b64decode.vectors:
  kind: python_call_eq
  category: decode_vector
  id_prefix: b64decode
  function: b64decode

  columns: [id, args, expected]
  rows:
    - [rfc4648_empty,  [""],         !ascii ""]
    - [rfc4648_f,      ["Zg=="],     !ascii f]
    - [rfc4648_fo,     ["Zm8="],     !ascii fo]
    - [rfc4648_foo,    ["Zm9v"],     !ascii foo]
    - [rfc4648_foobar, ["Zm9vYmFy"], !ascii foobar]
    - [binary_input,   ["+//+"],     !hex fbfffe]

table theseus_base64_q.urlsafe:
  kind: python_call_eq
  category: urlsafe

  columns: [id, function, args, expected]
  rows:
    - [urlsafe_b64encode.replaces_plus_slash, urlsafe_b64encode, [!hex fbfffe], !ascii "-__-"]
    - [urlsafe_b64decode.accepts_dash_underscore, urlsafe_b64decode, ["-__-"], !hex fbfffe]

table theseus_base64_q.b32encode.rfc4648:
  kind: python_call_eq
  category: b32
  function: b32encode
  id_prefix: b32encode

  columns: [id, args, expected]
  rows:
    - [rfc4648_foo,    [!ascii foo],    !ascii MZXW6===]
    - [rfc4648_foobar, [!ascii foobar], !ascii MZXW6YTBOI======]
