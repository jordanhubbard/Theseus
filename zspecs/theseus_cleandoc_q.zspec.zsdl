spec: theseus_cleandoc_q
version: ">=3.9"
backend: python_cleanroom(theseus_cleandoc_q)
blocks: inspect

docs: https://docs.python.org/3/library/inspect.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/inspect.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room inspect.cleandoc. Do NOT import inspect."
    - "Export: cleandoc."
    - "cleandoc removes common leading indentation and blank leading or trailing lines."
    - "Authority: gold/cleandoc/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_cleandoc_q.two_lines:
  description: "common indent is removed"
  kind: python_call_eq
  function: cleandoc
  args: ["  foo\n    bar"]
  expected: "foo\nbar"
