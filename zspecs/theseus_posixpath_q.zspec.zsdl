spec: theseus_posixpath_q
version: ">=3.9"
backend: python_cleanroom(theseus_posixpath_q)
blocks: posixpath

docs: https://docs.python.org/3/library/os.path.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/os.path.html"
  not_derived_from:
    - "CPython source: Lib/posixpath.py"
  notes:
    - "Clean-room posixpath. Do NOT import posixpath or os.path."
    - "Export: join, basename, normpath, splitext."
    - "The separator is slash. join inserts a slash. An absolute later component replaces what came before."
    - "Authority: gold/posixpath/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_posixpath_q.join_two:
  description: "join two relative parts"
  kind: python_call_eq
  function: join
  args: ["a", "b"]
  expected: "a/b"

invariant theseus_posixpath_q.base_tmp:
  description: "basename of a slash path"
  kind: python_call_eq
  function: basename
  args: ["/tmp/x"]
  expected: "x"
