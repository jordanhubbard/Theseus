spec: theseus_math_q
version: ">=3.9"
backend: python_cleanroom(theseus_math_q)
blocks: math

docs: https://docs.python.org/3/library/math.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/math.html"
  not_derived_from:
    - "CPython source: Modules/mathmodule.c"
  notes:
    - "Clean-room math. Do NOT import math."
    - "Export: factorial, gcd, isqrt."
    - "factorial is 1 for 0 and the product 1..n otherwise. gcd is the Euclidean algorithm. isqrt is the integer square root."
    - "Authority: gold/math/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_math_q.fact_five:
  description: "factorial of five"
  kind: python_call_eq
  function: factorial
  args: [5]
  expected: 120

invariant theseus_math_q.gcd_pair:
  description: "gcd of twelve and eighteen"
  kind: python_call_eq
  function: gcd
  args: [12, 18]
  expected: 6
