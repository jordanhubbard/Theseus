spec: theseus_hashlib_q
version: ">=3.9"
backend: python_cleanroom(theseus_hashlib_q)
blocks: hashlib

docs: https://docs.python.org/3/library/hashlib.html
rfcs:
  - "FIPS 180-4 — Secure Hash Standard (SHS)"

provenance:
  derived_from:
    - "FIPS 180-4 SHA-256 known-answer tests (empty and 'abc')"
    - "https://docs.python.org/3/library/hashlib.html"
  not_derived_from:
    - "CPython source: Modules/_hashopenssl.c"
    - "CPython source: Modules/_sha256module.c"
    - "OpenSSL source: crypto/sha/sha256.c"
  notes:
    - "Clean-room SHA-256. Do NOT import hashlib, _hashlib, _sha2, or OpenSSL."
    - "Export: sha256 — constructor returning an object with hexdigest/digest/update/copy."
    - "Authority: gold/hashlib/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

invariant theseus_hashlib_q.sha256.empty:
  description: "SHA-256 of the empty message"
  category: known_vector
  rfc: "FIPS 180-4"
  kind: python_call_eq
  function: sha256
  args: [{type: bytes_ascii, value: ""}]
  method: hexdigest
  expected: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

invariant theseus_hashlib_q.sha256.abc:
  description: "SHA-256 of 'abc'"
  category: known_vector
  rfc: "FIPS 180-4"
  kind: python_call_eq
  function: sha256
  args: [{type: bytes_ascii, value: "abc"}]
  method: hexdigest
  expected: "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

invariant theseus_hashlib_q.sha256.name:
  description: "sha256(b'').name == 'sha256'"
  category: properties
  kind: python_call_eq
  function: sha256
  args: [{type: bytes_ascii, value: ""}]
  method: name
  expected: "sha256"

invariant theseus_hashlib_q.sha256.digest_size:
  description: "sha256(b'').digest_size == 32"
  category: properties
  kind: python_call_eq
  function: sha256
  args: [{type: bytes_ascii, value: ""}]
  method: digest_size
  expected: 32
