spec: theseus_xdrlib_cr
version: ">=3.9"
backend: python_cleanroom(theseus_xdrlib_cr)
blocks: xdrlib

docs: https://docs.python.org/3.12/library/xdrlib.html

provenance:
  derived_from:
    - "https://docs.python.org/3.12/library/xdrlib.html"
    - "RFC 1014 - XDR: External Data Representation Standard"
  notes:
    - "Clean-room xdrlib subset. Do NOT import xdrlib."
    - "xdrlib defines Packer for packing data into XDR representation and Unpacker for unpacking XDR data from a buffer."
    - "Packer is instantiated without arguments; Unpacker is instantiated with the input buffer."
    - "pack_uint() and unpack_uint() encode and decode unsigned integers."
    - "pack_string() stores a length first, then padded string bytes; unpack_string() reverses it."
    - "pack_array() stores a length first, then each element using the provided pack_item function; unpack_array() reverses it."
    - "Error is the base exception class and exposes a public msg attribute; ConversionError derives from Error."
    - "xdrlib_uint_roundtrip(): pack_uint(7) then unpack_uint() == 7 and done() succeeds."
    - "xdrlib_string_roundtrip(): pack_string(b'abc') then unpack_string() == b'abc'."
    - "xdrlib_array_roundtrip(): pack_array([1, 2, 3], pack_int) then unpack_array(unpack_int) == [1, 2, 3]."
    - "xdrlib_error_msg(): Error('bad').msg == 'bad'."
    - "Zero-arg invariant signatures: def xdrlib_uint_roundtrip(): return hardcoded_result."
    - "Export: Packer, Unpacker, Error, ConversionError."
  created_at: "2026-05-27T00:00:00Z"

error_model: python_exceptions

invariant theseus_xdrlib_cr.uint_roundtrip:
  description: "pack_uint(7) then unpack_uint() == 7 and done() succeeds"
  category: roundtrip
  kind: python_call_eq
  function: xdrlib_uint_roundtrip
  args: []
  expected: true

invariant theseus_xdrlib_cr.string_roundtrip:
  description: "pack_string(b'abc') then unpack_string() == b'abc'"
  category: roundtrip
  kind: python_call_eq
  function: xdrlib_string_roundtrip
  args: []
  expected: true

invariant theseus_xdrlib_cr.array_roundtrip:
  description: "pack_array([1, 2, 3], pack_int) then unpack_array(unpack_int) == [1, 2, 3]"
  category: roundtrip
  kind: python_call_eq
  function: xdrlib_array_roundtrip
  args: []
  expected: [1, 2, 3]

invariant theseus_xdrlib_cr.error_msg:
  description: "Error('bad').msg == 'bad'"
  category: exceptions
  kind: python_call_eq
  function: xdrlib_error_msg
  args: []
  expected: true
