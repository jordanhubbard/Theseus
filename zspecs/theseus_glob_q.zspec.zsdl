spec: theseus_glob_q
version: ">=3.9"
backend: python_cleanroom(theseus_glob_q)
blocks: glob

docs: https://docs.python.org/3/library/glob.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/glob.html"
  not_derived_from:
    - "CPython source: Lib/glob.py"
  notes:
    - "Clean-room glob. Do NOT import glob."
    - "Export: escape."
    - "escape quotes *, ?, and [ so a later glob treats them as literals."
    - "Authority: gold/glob/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_glob_q.escape_star:
  description: "escape a star"
  kind: python_call_eq
  function: escape
  args: ["a*b"]
  expected: "a[*]b"
