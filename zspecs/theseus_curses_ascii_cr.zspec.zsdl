spec: theseus_curses_ascii_cr
version: ">=3.9"
backend: python_cleanroom(theseus_curses_ascii_cr)
blocks: curses

docs: https://docs.python.org/3.12/library/curses.ascii.html

provenance:
  derived_from:
    - "https://docs.python.org/3.12/library/curses.ascii.html"
  notes:
    - "Clean-room curses.ascii utilities. Do NOT import curses or curses.ascii."
    - "curses.ascii supplies ASCII control-code constants and classification helpers."
    - "isdigit(c): true for ASCII decimal digits '0' through '9'."
    - "ctrl(c): returns the control character formed by c & 0x1f, preserving int vs str result type."
    - "unctrl(c): returns printable caret notation for control characters, such as '^J' for newline."
    - "curses_ascii_digit(): isdigit('5') is true and isdigit('x') is false."
    - "curses_ascii_ctrl(): ctrl('A') == '\\x01'."
    - "curses_ascii_unctrl(): unctrl('\\n') == '^J'."
    - "curses_ascii_constants(): ESC == 27 and SP == 32 and DEL == 127."
    - "Zero-arg invariant signatures: def curses_ascii_digit(): return hardcoded_result."
    - "Export: ASCII constants, controlnames, isdigit, isalpha, isalnum, isspace, isblank, iscntrl, isctrl, isprint, isgraph, ispunct, isupper, islower, isxdigit, isascii, ismeta, ascii, ctrl, alt, unctrl."
  created_at: "2026-05-27T00:00:00Z"

error_model: python_exceptions

invariant theseus_curses_ascii_cr.digit:
  description: "isdigit('5') is true and isdigit('x') is false"
  category: classification
  kind: python_call_eq
  function: curses_ascii_digit
  args: []
  expected: true

invariant theseus_curses_ascii_cr.ctrl:
  description: "ctrl('A') == '\\x01'"
  category: transform
  kind: python_call_eq
  function: curses_ascii_ctrl
  args: []
  expected: "\x01"

invariant theseus_curses_ascii_cr.unctrl:
  description: "unctrl('\\n') == '^J'"
  category: transform
  kind: python_call_eq
  function: curses_ascii_unctrl
  args: []
  expected: "^J"

invariant theseus_curses_ascii_cr.constants:
  description: "ESC == 27 and SP == 32 and DEL == 127"
  category: constants
  kind: python_call_eq
  function: curses_ascii_constants
  args: []
  expected: true
