spec: theseus_ntpath_q
version: ">=3.9"
backend: python_cleanroom(theseus_ntpath_q)
blocks: ntpath

docs: https://docs.python.org/3/library/os.path.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/os.path.html"
  not_derived_from:
    - "CPython source: Lib/ntpath.py"
  notes:
    - "Clean-room ntpath. Do NOT import ntpath or os.path."
    - "Export: join, splitdrive, basename, normpath."
    - "The separator is backslash. splitdrive separates a drive letter from the rest."
    - "Authority: gold/ntpath/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_ntpath_q.join_two:
  description: "join two relative parts"
  kind: python_call_eq
  function: join
  args: ["a", "b"]
  expected: "a\\b"

invariant theseus_ntpath_q.drive:
  description: "split a drive letter"
  kind: python_call_eq
  function: splitdrive
  args: ["C:\\foo"]
  expected: !tuple ["C:", "\\foo"]
