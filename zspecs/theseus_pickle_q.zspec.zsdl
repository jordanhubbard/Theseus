spec: theseus_pickle_q
version: ">=3.9"
backend: python_cleanroom(theseus_pickle_q)
blocks: pickle

docs: https://docs.python.org/3/library/pickle.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/pickle.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room pickle.dumps protocol 0. Do NOT import pickle."
    - "Export: dumps."
    - "dumps(obj, protocol=0) emits protocol-0 opcodes. A one-item list of an int is a list mark, an integer opcode, and append/stop."
    - "Authority: gold/pickle/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_pickle_q.list_one:
  description: "protocol 0 list of one int"
  kind: python_call_eq
  function: dumps
  args: [[1]]
  kwargs: {protocol: 0}
  expected: !ascii "(lp0\nI1\na."
