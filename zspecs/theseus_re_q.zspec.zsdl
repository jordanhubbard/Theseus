spec: theseus_re_q
version: ">=3.9"
backend: python_cleanroom(theseus_re_q)
blocks: re

docs: https://docs.python.org/3/library/re.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/re.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room re.escape. Do NOT import re."
    - "Export: escape."
    - "escape backslash-escapes every character that is not an ASCII letter, digit, or underscore."
    - "Authority: gold/re/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_re_q.escape_dot_star:
  description: "dot and star are escaped"
  kind: python_call_eq
  function: escape
  args: ["a.b*c"]
  expected: "a\\.b\\*c"
