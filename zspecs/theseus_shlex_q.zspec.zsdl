spec: theseus_shlex_q
version: ">=3.8"
backend: python_cleanroom(theseus_shlex_q)
blocks: shlex

docs: https://docs.python.org/3/library/shlex.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/shlex.html"
  not_derived_from:
    - "CPython source: Lib/shlex.py"
  notes:
    - "Clean-room shlex. Do NOT import shlex."
    - "Export: split, quote, join."
    - "Authority: gold/shlex/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

table theseus_shlex_q.split.basic:
  kind: python_call_eq
  category: split
  id_prefix: split
  function: split

  columns: [id, args, expected]
  rows:
    - [simple_two_words,      ["hello world"],           ["hello", "world"]]
    - [double_quoted_phrase,  ["\"hello world\""],        ["hello world"]]
    - [single_quoted_phrase,  ["echo 'foo bar'"],         ["echo", "foo bar"]]
    - [empty_string,          [""],                       []]
    - [hash_comment,          ["a # ignored"],            ["a"], {kwargs: {comments: true}}]

table theseus_shlex_q.quote.basic:
  kind: python_call_eq
  category: quote
  id_prefix: quote
  function: quote

  columns: [id, args, expected]
  rows:
    - [safe_word,   ["hello"],       "hello"]
    - [with_space,  ["hello world"], "'hello world'"]
    - [empty_string,[""],            "''"]

table theseus_shlex_q.join.basic:
  kind: python_call_eq
  category: join
  id_prefix: join
  function: join

  columns: [id, args, expected]
  rows:
    - [two_safe_tokens,  [["echo", "hello"]],       "echo hello"]
    - [token_with_space, [["echo", "hello world"]], "echo 'hello world'"]
