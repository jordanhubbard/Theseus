# Function name checks — all public _heapq functions
# ---------------------------------------------------------------------------

table _heapq.function_names:
  kind: python_call_eq
  category: functions
  id_prefix: fname
  columns:
  - id
  - function
  - args
  - expected
  rows:
  - - heappush
    - heappush.__name__.__eq__
    - - heappush
    - true
  - - heappop
    - heappop.__name__.__eq__
    - - heappop
    - true
  - - heapify
    - heapify.__name__.__eq__
    - - heapify
    - true
  - - heapreplace
    - heapreplace.__name__.__eq__
    - - heapreplace
    - true
  - - heappushpop
    - heappushpop.__name__.__eq__
    - - heappushpop
    - true

table _heapq.function_modules:
  kind: python_call_eq
  category: functions
  id_prefix: fmod
  columns:
  - id
  - function
  - args
  - expected
  rows:
  - - heappush
    - heappush.__module__.__eq__
    - - _heapq
    - true
  - - heappop
    - heappop.__module__.__eq__
    - - _heapq
    - true
  - - heapify
    - heapify.__module__.__eq__
    - - _heapq
    - true
  - - heapreplace
    - heapreplace.__module__.__eq__
    - - _heapq
    - true
  - - heappushpop
    - heappushpop.__module__.__eq__
    - - _heapq
    - true

invariant _heapq.heapify_returns_none:
  description: "heapify([3,1,2]) returns None — in-place operation has no return value"
  category: behavioral
  kind: python_call_eq
  function: heapify
  args: [[3, 1, 2]]
  expected: ~

# ---------------------------------------------------------------------------
# heappop — returns minimum from a valid min-heap
# ---------------------------------------------------------------------------

invariant _heapq.heappop_min:
  description: "heappop([1,2,3]) == 1 — returns the minimum element"
  category: behavioral
  kind: python_call_eq
  function: heappop
  args: [[1, 2, 3]]
  expected: 1

# ---------------------------------------------------------------------------
# nlargest — returns top-n in descending order
# ---------------------------------------------------------------------------

invariant _heapq.nlargest_two:
  description: Empty-heap removal raises IndexError
  category: behavioral
  kind: python_call_raises
  function: heappop
  args:
  - []
  expected_exception: IndexError

invariant _heapq.nlargest_one:
  description: Empty-heap removal raises IndexError
  category: behavioral
  kind: python_call_raises
  function: heapreplace
  args:
  - []
  - 1
  expected_exception: IndexError

invariant _heapq.nsmallest_two:
  description: 'Documented heap primitive: heappushpop on bounded inputs'
  category: behavioral
  kind: python_call_eq
  function: heappushpop
  args:
  - []
  - 7
  expected: 7

invariant _heapq.nsmallest_one:
  description: 'Documented heap primitive: heapify on bounded inputs'
  category: behavioral
  kind: python_call_eq
  function: heapify
  args:
  - - 3
    - 2
    - 1
  expected: null

