provenance:
  derived_from:
    - "https://docs.python.org/3/library/itertools.html"
  not_derived_from:
    - "CPython source: Modules/itertoolsmodule.c"
  notes:
    - "Clean-room itertools. Do NOT import itertools."
    - "Export: product, combinations."
    - "product yields the cartesian product. combinations yields r-length subsequences in order."
