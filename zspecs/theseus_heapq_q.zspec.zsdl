spec: theseus_heapq_q
version: ">=3.9"
backend: python_cleanroom(theseus_heapq_q)
blocks: heapq

docs: https://docs.python.org/3/library/heapq.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/heapq.html"
  not_derived_from:
    - "CPython source: Lib/heapq.py"
  notes:
    - "Clean-room heapq. Do NOT import heapq."
    - "Export: nlargest, nsmallest, heapify, heappush, heappop."
    - "Authority: gold/heapq/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_heapq_q.nlargest_basic:
  description: "two largest of three"
  kind: python_call_eq
  function: nlargest
  args: [2, [1, 5, 3]]
  expected: [5, 3]

invariant theseus_heapq_q.nsmallest_basic:
  description: "one smallest"
  kind: python_call_eq
  function: nsmallest
  args: [1, [1, 5, 3]]
  expected: [1]
