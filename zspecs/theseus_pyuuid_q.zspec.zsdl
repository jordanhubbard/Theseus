spec: theseus_pyuuid_q
version: ">=3.9"
backend: python_cleanroom(theseus_pyuuid_q)
blocks: uuid

docs: https://docs.python.org/3/library/uuid.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/uuid.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room uuid. Do NOT import uuid."
    - "Export: UUID, uuid5."
    - "UUID(hex_string).hex is the 32 hex digits without hyphens."
    - "uuid5(namespace, name) is the RFC 4122 version-5 UUID for that namespace UUID string and name."
    - "Authority: gold/pyuuid/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_pyuuid_q.hex_form:
  description: "hyphenated hex becomes 32 digits"
  kind: python_call_eq
  function: UUID
  args: ["12345678-1234-5678-1234-567812345678"]
  method: hex
  method_args: []
  expected: "12345678123456781234567812345678"
