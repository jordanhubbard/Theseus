spec: theseus_indent_q
version: ">=3.9"
backend: python_cleanroom(theseus_indent_q)
blocks: textwrap

docs: https://docs.python.org/3/library/textwrap.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/textwrap.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room textwrap.indent. Do NOT import textwrap."
    - "Export: indent."
    - "indent prefixes every non-blank line."
    - "Authority: gold/indent/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_indent_q.two_lines:
  description: "two lines gain a two-space prefix"
  kind: python_call_eq
  function: indent
  args: ["hi\nthere", "  "]
  expected: "  hi\n  there"
