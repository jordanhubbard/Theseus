spec: theseus_copy_q
version: ">=3.9"
backend: python_cleanroom(theseus_copy_q)
blocks: copy

docs: https://docs.python.org/3/library/copy.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/copy.html"
  not_derived_from:
    - "CPython source: Lib/copy.py"
  notes:
    - "Clean-room copy. Do NOT import copy."
    - "Export: copy, deepcopy."
    - "copy duplicates one container level. deepcopy duplicates nested containers. Returned values compare equal to the input for lists and dicts of ints."
    - "Authority: gold/copy/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_copy_q.shallow_list:
  description: "shallow copy of a list"
  kind: python_call_eq
  function: copy
  args: [[1, 2]]
  expected: [1, 2]

invariant theseus_copy_q.deep_nested:
  description: "deep copy of a nested list"
  kind: python_call_eq
  function: deepcopy
  args: [[[1]]]
  expected: [[1]]
