spec: theseus_fnmatchcase_q
version: ">=3.9"
backend: python_cleanroom(theseus_fnmatchcase_q)
blocks: fnmatch

docs: https://docs.python.org/3/library/fnmatch.html

provenance:
  derived_from:
    - "https://docs.python.org/3/library/fnmatch.html"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "Clean-room fnmatch. Do NOT import fnmatch."
    - "Export: fnmatch, fnmatchcase."
    - "fnmatch matches a name against a shell pattern. fnmatchcase is case-sensitive. * matches any sequence."
    - "Authority: gold/fnmatchcase/package.md. Held-out oracle is NOT this file."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_fnmatchcase_q.star_txt:
  description: "star matches a txt name"
  kind: python_call_eq
  function: fnmatch
  args: ["a.txt", "*.txt"]
  expected: true
