{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/characterization-record.schema.json",
  "title": "Theseus Characterization Record",
  "description": "Projection of a gold-set family (authority, oracles, ledger). Distinct from package recipes (ADR 0006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "family",
    "authority",
    "public_oracle",
    "ladder",
    "qualification",
    "uncertainty_ledger"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "kind": { "type": "string", "enum": ["characterization_record"] },
    "family": { "type": "string" },
    "authority": { "type": "string", "description": "Repo-relative path to gold/<family>/package.md" },
    "public_oracle": { "type": "string" },
    "cleanroom_oracle": { "type": ["string", "null"] },
    "held_out_oracle": { "type": ["string", "null"] },
    "implementation": { "type": ["string", "null"] },
    "uncertainty_ledger": { "type": "string" },
    "probes": { "type": ["string", "null"] },
    "blocks": { "type": ["string", "null"] },
    "exports": { "type": "array", "items": { "type": "string" } },
    "ladder": { "type": "string" },
    "qualification": { "type": "string", "enum": ["none"] },
    "docs": { "type": "array", "items": { "type": "string" } },
    "rfcs": { "type": "array", "items": { "type": "string" } }
  }
}
