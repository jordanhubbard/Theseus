{
  "$id": "https://example.org/schema/fingerprint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSS Package Fingerprint",
  "description": "Git-backed identity record for an open-source package. Primary fields are provenance, tracking, and dependencies. Recreation-from-spec is secondary evidence. Reverse dependencies are derived from the committed graph, not stored.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "kind",
    "identity",
    "license",
    "depends_on",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.1"]
    },
    "kind": {
      "type": "string",
      "const": "oss_fingerprint"
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["canonical_name", "canonical_id"],
      "properties": {
        "canonical_name": { "type": "string" },
        "canonical_id": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "url": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "web": { "type": ["string", "null"] },
        "confidence": { "type": "number" },
        "source": { "type": ["string", "null"] },
        "candidates": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": true,
      "required": ["spdx", "raw"],
      "properties": {
        "spdx": {
          "type": "array",
          "items": { "type": "string" }
        },
        "raw": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number" }
      }
    },
    "homepage": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": ["string", "null"]
    },
    "ecosystems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["ecosystem"],
        "properties": {
          "ecosystem": { "type": "string" },
          "ecosystem_id": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] },
          "canonical_id": { "type": ["string", "null"] }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "scope"],
        "properties": {
          "name": { "type": "string" },
          "scope": {
            "type": "string",
            "enum": ["runtime", "build", "host", "test"]
          },
          "ecosystem": { "type": ["string", "null"] },
          "resolved": { "type": "boolean" },
          "resolved_to": { "type": ["string", "null"] }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "recipes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "behavioral_spec": {
          "type": ["string", "null"]
        },
        "recreation": {
          "type": "string",
          "description": "Recreation-from-spec is retained as secondary evidence, not the ingest priority."
        }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "primary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": true,
      "description": "Cross-ecosystem identity, maintainers, distributions, source commits, and dependency resolution counts.",
      "properties": {
        "ingested_at": { "type": "string" },
        "recipe_count": { "type": "integer" },
        "maintainers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_repo_commits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "build_systems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "distributions": { "type": "array" },
        "dropped_dependencies": { "type": "array" },
        "dep_edges": { "type": "integer" },
        "dep_resolved": { "type": "integer" },
        "dep_dangling": { "type": "integer" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generated_by", "imported_at", "confidence", "sources"],
      "properties": {
        "generated_by": { "type": "string" },
        "imported_at": { "type": "string" },
        "confidence": { "type": "number" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["path", "kind"],
            "properties": {
              "path": { "type": "string" },
              "kind": { "type": "string" },
              "imported_at": { "type": ["string", "null"] },
              "generated_by": { "type": ["string", "null"] },
              "source_path": { "type": ["string", "null"] },
              "source_repo_commit": { "type": ["string", "null"] },
              "confidence": { "type": ["number", "null"] },
              "unmapped": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
