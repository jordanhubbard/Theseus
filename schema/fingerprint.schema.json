{
  "$id": "https://example.org/schema/fingerprint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSS Package Fingerprint",
  "description": "Git-backed identity record for an open-source package: provenance, repository, license, and outbound dependencies. Reverse dependencies are derived from the committed graph, not stored.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "kind",
    "identity",
    "license",
    "depends_on",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "oss_fingerprint"
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["canonical_name", "canonical_id"],
      "properties": {
        "canonical_name": { "type": "string" },
        "canonical_id": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "url": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "web": { "type": ["string", "null"] },
        "confidence": { "type": "number" },
        "source": { "type": ["string", "null"] },
        "candidates": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": true,
      "required": ["spdx", "raw"],
      "properties": {
        "spdx": {
          "type": "array",
          "items": { "type": "string" }
        },
        "raw": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number" }
      }
    },
    "homepage": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": ["string", "null"]
    },
    "ecosystems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["ecosystem"],
        "properties": {
          "ecosystem": { "type": "string" },
          "ecosystem_id": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] },
          "canonical_id": { "type": ["string", "null"] }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "scope"],
        "properties": {
          "name": { "type": "string" },
          "scope": {
            "type": "string",
            "enum": ["runtime", "build", "host", "test"]
          },
          "ecosystem": { "type": ["string", "null"] }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "recipes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "behavioral_spec": {
          "type": ["string", "null"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generated_by", "imported_at", "confidence", "sources"],
      "properties": {
        "generated_by": { "type": "string" },
        "imported_at": { "type": "string" },
        "confidence": { "type": "number" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["path", "kind"],
            "properties": {
              "path": { "type": "string" },
              "kind": { "type": "string" },
              "imported_at": { "type": ["string", "null"] },
              "generated_by": { "type": ["string", "null"] }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
