spec: theseus_textwrap_q
version: ">=3.9"
backend: python_cleanroom(theseus_textwrap_q)
blocks: textwrap

docs: https://docs.python.org/3/library/textwrap.html

provenance:
  derived_from:
    - "Public textwrap docs — held-out vectors not in zspecs/theseus_textwrap_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/textwrap.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_textwrap_q.held_out.wrap_words:
  description: "wrap three words"
  kind: python_call_eq
  function: wrap
  args: ["alpha beta gamma"]
  kwargs: {width: 10}
  expected: ["alpha beta", "gamma"]

invariant theseus_textwrap_q.held_out.indent_gt:
  description: "indent with a prefix"
  kind: python_call_eq
  function: indent
  args: ["a\nb\n", "> "]
  expected: "> a\n> b\n"
