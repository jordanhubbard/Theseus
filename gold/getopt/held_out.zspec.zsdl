spec: theseus_getopt_q
version: ">=3.9"
backend: python_cleanroom(theseus_getopt_q)
blocks: getopt

docs: https://docs.python.org/3/library/getopt.html

provenance:
  derived_from:
    - "Public getopt docs — held-out vectors not in zspecs/theseus_getopt_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/getopt.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_getopt_q.held_out.with_value:
  description: "short option that takes a value"
  kind: python_call_eq
  function: getopt
  args: [["-n", "photo"], "n:"]
  expected: !tuple
    - - !tuple ["-n", "photo"]
    - []
