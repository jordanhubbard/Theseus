spec: theseus_colorsys_q
version: ">=3.9"
backend: python_cleanroom(theseus_colorsys_q)
blocks: colorsys

docs: https://docs.python.org/3/library/colorsys.html

provenance:
  derived_from:
    - "Public colorsys docs — held-out vectors not in zspecs/theseus_colorsys_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/colorsys.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_colorsys_q.held_out.green_hsv:
  description: "pure green in HSV"
  kind: python_call_eq
  function: rgb_to_hsv
  args: [0.0, 1.0, 0.0]
  expected: !tuple [0.3333333333333333, 1.0, 1.0]

invariant theseus_colorsys_q.held_out.blue_hls:
  description: "pure blue in HLS"
  kind: python_call_eq
  function: rgb_to_hls
  args: [0.0, 0.0, 1.0]
  expected: !tuple [0.6666666666666666, 0.5, 1.0]
