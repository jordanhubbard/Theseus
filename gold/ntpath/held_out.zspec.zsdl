spec: theseus_ntpath_q
version: ">=3.9"
backend: python_cleanroom(theseus_ntpath_q)
blocks: ntpath

docs: https://docs.python.org/3/library/os.path.html

provenance:
  derived_from:
    - "Public os.path docs — held-out vectors not in zspecs/theseus_ntpath_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/ntpath.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_ntpath_q.held_out.base_file:
  description: "basename after a drive"
  kind: python_call_eq
  function: basename
  args: ["C:\\dir\\file.txt"]
  expected: "file.txt"

invariant theseus_ntpath_q.held_out.norm_parent:
  description: "collapse a parent segment"
  kind: python_call_eq
  function: normpath
  args: ["a\\..\\b"]
  expected: "b"
