spec: theseus_ipaddress_q
version: ">=3.9"
backend: python_cleanroom(theseus_ipaddress_q)
blocks: ipaddress

docs: https://docs.python.org/3/library/ipaddress.html

provenance:
  derived_from:
    - "Public ipaddress docs — held-out vectors not in zspecs/theseus_ipaddress_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/ipaddress.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_ipaddress_q.held_out.loopback:
  description: "loopback flag"
  kind: python_call_eq
  function: IPv4Address
  args: ["127.0.0.1"]
  method: is_loopback
  method_args: []
  expected: true

invariant theseus_ipaddress_q.held_out.private_ten:
  description: "RFC 1918 ten-net"
  kind: python_call_eq
  function: IPv4Address
  args: ["10.1.2.3"]
  method: is_private
  method_args: []
  expected: true
