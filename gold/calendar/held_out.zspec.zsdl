spec: theseus_calendar_q
version: ">=3.9"
backend: python_cleanroom(theseus_calendar_q)
blocks: calendar

docs: https://docs.python.org/3/library/calendar.html

provenance:
  derived_from:
    - "Public calendar docs — held-out vectors not in zspecs/theseus_calendar_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/calendar.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_calendar_q.held_out.not_1900:
  description: "1900 is not a leap year"
  kind: python_call_eq
  function: isleap
  args: [1900]
  expected: false

invariant theseus_calendar_q.held_out.saturday_2000:
  description: "1 January 2000 is Saturday"
  kind: python_call_eq
  function: weekday
  args: [2000, 1, 1]
  expected: 5

invariant theseus_calendar_q.held_out.leap_span:
  description: "leap days from 2000 inclusive to 2025 exclusive"
  kind: python_call_eq
  function: leapdays
  args: [2000, 2025]
  expected: 7

invariant theseus_calendar_q.held_out.february_2023:
  description: "February 2023 starts Wednesday and has 28 days"
  kind: python_call_eq
  function: monthrange
  args: [2023, 2]
  expected: !tuple [2, 28]
