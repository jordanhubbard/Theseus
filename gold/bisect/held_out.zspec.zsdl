spec: theseus_bisect_q
version: ">=3.9"
backend: python_cleanroom(theseus_bisect_q)
blocks: bisect

docs: https://docs.python.org/3/library/bisect.html

provenance:
  derived_from:
    - "Public bisect docs — held-out vectors not in zspecs/theseus_bisect_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/bisect.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_bisect_q.held_out.evens:
  description: "bisect_left on evens"
  kind: python_call_eq
  function: bisect_left
  args: [[2, 4, 6, 8], 5]
  expected: 2

invariant theseus_bisect_q.held_out.dupes:
  description: "bisect_right past duplicates"
  kind: python_call_eq
  function: bisect_right
  args: [[1, 1, 1], 1]
  expected: 3
