spec: theseus_html_q
version: ">=3.9"
backend: python_cleanroom(theseus_html_q)
blocks: html

docs: https://docs.python.org/3/library/html.html

provenance:
  derived_from:
    - "Public html docs — held-out vectors not in zspecs/theseus_html_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/html/__init__.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_html_q.held_out.amp_mid:
  description: "escape an ampersand between letters"
  kind: python_call_eq
  function: escape
  args: ["a&b"]
  expected: "a&amp;b"

invariant theseus_html_q.held_out.hex_ref:
  description: "unescape a hex character reference"
  kind: python_call_eq
  function: unescape
  args: ["&#x41;"]
  expected: "A"
