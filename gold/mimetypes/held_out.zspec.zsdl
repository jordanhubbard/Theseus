spec: theseus_mimetypes_q
version: ">=3.9"
backend: python_cleanroom(theseus_mimetypes_q)
blocks: mimetypes

docs: https://docs.python.org/3/library/mimetypes.html

provenance:
  derived_from:
    - "Public mimetypes docs — held-out vectors not in zspecs/theseus_mimetypes_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/mimetypes.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_mimetypes_q.held_out.png:
  description: "png image type"
  kind: python_call_eq
  function: guess_type
  args: ["photo.png"]
  expected: !tuple ["image/png", null]

invariant theseus_mimetypes_q.held_out.gz:
  description: "gzip encoding"
  kind: python_call_eq
  function: guess_type
  args: ["notes.gz"]
  expected: !tuple [null, "gzip"]
