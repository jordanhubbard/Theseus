spec: theseus_hexlify_q
version: ">=3.9"
backend: python_cleanroom(theseus_hexlify_q)
blocks: binascii

docs: https://docs.python.org/3/library/binascii.html

provenance:
  derived_from:
    - "Public docs — held-out vectors not in zspecs/theseus_hexlify_q.zspec.zsdl"
  not_derived_from:
    - "CPython implementation source"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_hexlify_q.held_out.three_bytes:
  description: "three bytes become six hex digits"
  kind: python_call_eq
  function: hexlify
  args: [!ascii "xyz"]
  expected: !ascii "78797a"
