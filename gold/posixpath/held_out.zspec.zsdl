spec: theseus_posixpath_q
version: ">=3.9"
backend: python_cleanroom(theseus_posixpath_q)
blocks: posixpath

docs: https://docs.python.org/3/library/os.path.html

provenance:
  derived_from:
    - "Public os.path docs — held-out vectors not in zspecs/theseus_posixpath_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/posixpath.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-22T00:00:00Z"

error_model: python_exceptions

invariant theseus_posixpath_q.held_out.norm_parent:
  description: "collapse a parent segment"
  kind: python_call_eq
  function: normpath
  args: ["a/../c"]
  expected: "c"

invariant theseus_posixpath_q.held_out.split_tar:
  description: "split the last suffix"
  kind: python_call_eq
  function: splitext
  args: ["archive.tar.gz"]
  expected: !tuple ["archive.tar", ".gz"]
