spec: theseus_heapq_q
version: ">=3.9"
backend: python_cleanroom(theseus_heapq_q)
blocks: heapq

docs: https://docs.python.org/3/library/heapq.html

provenance:
  derived_from:
    - "Public heapq docs — held-out vectors not in zspecs/theseus_heapq_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/heapq.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_heapq_q.held_out.largest_four:
  description: "two largest of four"
  kind: python_call_eq
  function: nlargest
  args: [2, [5, 1, 4, 9]]
  expected: [9, 5]

invariant theseus_heapq_q.held_out.smallest_four:
  description: "two smallest of four"
  kind: python_call_eq
  function: nsmallest
  args: [2, [5, 1, 4, 9]]
  expected: [1, 4]
