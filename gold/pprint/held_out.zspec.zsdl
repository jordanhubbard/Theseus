spec: theseus_pprint_q
version: ">=3.9"
backend: python_cleanroom(theseus_pprint_q)
blocks: pprint

docs: https://docs.python.org/3/library/pprint.html

provenance:
  derived_from:
    - "Public pprint docs — held-out vectors not in zspecs/theseus_pprint_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/pprint.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_pprint_q.held_out.sorted_dict:
  description: "dict keys are sorted"
  kind: python_call_eq
  function: pformat
  args: [{"b": 1, "a": 2}]
  expected: "{'a': 2, 'b': 1}"
