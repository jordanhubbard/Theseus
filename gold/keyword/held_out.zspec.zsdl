spec: theseus_keyword_q
version: ">=3.9"
backend: python_cleanroom(theseus_keyword_q)
blocks: keyword

docs: https://docs.python.org/3/library/keyword.html

provenance:
  derived_from:
    - "Public keyword docs — held-out vectors not in zspecs/theseus_keyword_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/keyword.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_keyword_q.held_out.lambda_kw:
  description: "lambda is a hard keyword"
  kind: python_call_eq
  function: iskeyword
  args: ["lambda"]
  expected: true

invariant theseus_keyword_q.held_out.type_soft:
  description: "type is a soft keyword"
  kind: python_call_eq
  function: issoftkeyword
  args: ["type"]
  expected: true
