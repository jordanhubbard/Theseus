spec: theseus_fnmatch_q
version: ">=3.9"
backend: python_cleanroom(theseus_fnmatch_q)
blocks: fnmatch

docs: https://docs.python.org/3/library/fnmatch.html

provenance:
  derived_from:
    - "Public fnmatch docs — held-out vectors not in zspecs/theseus_fnmatch_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/fnmatch.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

invariant theseus_fnmatch_q.held_out.index_html:
  description: "fnmatch('index.html', '*.html') is True"
  category: held_out
  kind: python_call_eq
  function: fnmatch
  args: ["index.html", "*.html"]
  expected: true

invariant theseus_fnmatch_q.held_out.fnmatchcase_changelog:
  description: "fnmatchcase('CHANGELOG.TXT', 'changelog.txt') is False"
  category: held_out
  kind: python_call_eq
  function: fnmatchcase
  args: ["CHANGELOG.TXT", "changelog.txt"]
  expected: false
