spec: theseus_statistics_q
version: ">=3.9"
backend: python_cleanroom(theseus_statistics_q)
blocks: statistics

docs: https://docs.python.org/3/library/statistics.html

provenance:
  derived_from:
    - "Public statistics docs — held-out vectors not in zspecs/theseus_statistics_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/statistics.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_statistics_q.held_out.median_even:
  description: "median averages the two middle values"
  kind: python_call_eq
  function: median
  args: [[1, 2, 3, 4]]
  expected: 2.5

invariant theseus_statistics_q.held_out.fmean_pair:
  description: "fast mean of 2 and 4"
  kind: python_call_eq
  function: fmean
  args: [[2, 4]]
  expected: 3.0
