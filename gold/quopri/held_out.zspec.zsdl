spec: theseus_quopri_q
version: ">=3.9"
backend: python_cleanroom(theseus_quopri_q)
blocks: quopri

docs: https://docs.python.org/3/library/quopri.html

provenance:
  derived_from:
    - "Public quopri docs — held-out vectors not in zspecs/theseus_quopri_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/quopri.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_quopri_q.held_out.equals:
  description: "equals sign is quoted"
  kind: python_call_eq
  function: encodestring
  args: [!ascii "foo=bar"]
  expected: !ascii "foo=3Dbar"

invariant theseus_quopri_q.held_out.round:
  description: "quoted equals decodes"
  kind: python_call_eq
  function: decodestring
  args: [!ascii "foo=3Dbar"]
  expected: !ascii "foo=bar"
