spec: theseus_urllib_parse_q
version: ">=3.4"
backend: python_cleanroom(theseus_urllib_parse_q)
blocks: urllib.parse

docs: https://docs.python.org/3/library/urllib.parse.html

provenance:
  derived_from:
    - "RFC 3986 — held-out vectors not in zspecs/theseus_urllib_parse_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/urllib/parse.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

invariant theseus_urllib_parse_q.held_out.urljoin_root:
  description: "urljoin replaces the path when the relative URL is absolute-path"
  category: held_out
  kind: python_call_eq
  function: urljoin
  args: ["http://ex.com/a/b", "/c"]
  expected: "http://ex.com/c"

invariant theseus_urllib_parse_q.held_out.quote_space:
  description: "quote('a b', safe='') percent-encodes the space"
  category: held_out
  kind: python_call_eq
  function: quote
  args: ["a b"]
  kwargs: {safe: ""}
  expected: "a%20b"
