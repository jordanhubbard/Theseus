spec: theseus_fractions_q
version: ">=3.9"
backend: python_cleanroom(theseus_fractions_q)
blocks: fractions

docs: https://docs.python.org/3/library/fractions.html

provenance:
  derived_from:
    - "Public fractions docs — held-out vectors not in zspecs/theseus_fractions_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/fractions.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_fractions_q.held_out.from_text:
  description: "ratio text reduces"
  kind: python_call_eq
  function: Fraction
  args: ["6/8"]
  method: __str__
  method_args: []
  expected: "3/4"

invariant theseus_fractions_q.held_out.zero_den:
  description: "zero denominator raises"
  kind: python_call_raises
  function: Fraction
  args: [1, 0]
  expected_exception: ZeroDivisionError
