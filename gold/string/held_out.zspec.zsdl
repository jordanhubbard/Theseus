spec: theseus_string_q
version: ">=3.9"
backend: python_cleanroom(theseus_string_q)
blocks: string

docs: https://docs.python.org/3/library/string.html

provenance:
  derived_from:
    - "Public string docs — held-out vectors not in zspecs/theseus_string_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/string.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-21T00:00:00Z"

error_model: python_exceptions

invariant theseus_string_q.held_out.squeeze:
  description: "collapse extra spaces"
  kind: python_call_eq
  function: capwords
  args: ["  a  b "]
  expected: "A B"

invariant theseus_string_q.held_out.hyphen:
  description: "custom separator"
  kind: python_call_eq
  function: capwords
  args: ["foo-bar"]
  kwargs: {sep: "-"}
  expected: "Foo-Bar"
