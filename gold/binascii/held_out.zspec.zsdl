spec: theseus_binascii_q
version: ">=3.9"
backend: python_cleanroom(theseus_binascii_q)
blocks: binascii

docs: https://docs.python.org/3/library/binascii.html

provenance:
  derived_from:
    - "ISO 3309 / public docs — held-out vectors not in zspecs/theseus_binascii_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Modules/binascii.c"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

invariant theseus_binascii_q.held_out.hexlify_dead:
  description: "hexlify(b'\\xde\\xad') == b'dead'"
  category: held_out
  kind: python_call_eq
  function: hexlify
  args: [{type: bytes_hex, value: "dead"}]
  expected: {type: bytes_ascii, value: "dead"}

invariant theseus_binascii_q.held_out.crc32_gold:
  description: "crc32(b'TheseusGold') == 2939617546"
  category: held_out
  kind: python_call_eq
  function: crc32
  args: [{type: bytes_ascii, value: "TheseusGold"}]
  expected: 2939617546
