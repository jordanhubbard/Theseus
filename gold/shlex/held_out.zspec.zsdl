spec: theseus_shlex_q
version: ">=3.8"
backend: python_cleanroom(theseus_shlex_q)
blocks: shlex

docs: https://docs.python.org/3/library/shlex.html

provenance:
  derived_from:
    - "Public shlex docs — held-out vectors not in zspecs/theseus_shlex_q.zspec.zsdl"
  not_derived_from:
    - "CPython source: Lib/shlex.py"
  notes:
    - "HELD-OUT ORACLE. Do not include these vectors in any synthesis prompt."
  created_at: "2026-09-18T00:00:00Z"

error_model: python_exceptions

invariant theseus_shlex_q.held_out.quote_ab:
  description: "quote('a b') wraps in single quotes"
  category: held_out
  kind: python_call_eq
  function: quote
  args: ["a b"]
  expected: "'a b'"

invariant theseus_shlex_q.held_out.split_cmd:
  description: "split(\"cmd 'x y'\") keeps the quoted phrase"
  category: held_out
  kind: python_call_eq
  function: split
  args: ["cmd 'x y'"]
  expected: ["cmd", "x y"]
